NODE_ENV=development
PORT=4000

# Must be at least 32 characters
JWT_SECRET=change-me-to-a-secure-random-string-32+

JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# ─── Lido Connect - NLP (Rasa) ─────────────────────────────────────────────
NLP_ADAPTER=rasa
RASA_URL=http://localhost:5005
RASA_TOKEN=
NLP_TIMEOUT=10000
NLP_RETRY_ATTEMPTS=2
NLP_CONFIDENCE_THRESHOLD=0.7

# ─── Lido Connect - WebRTC ─────────────────────────────────────────────────
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_SERVERS=[]
RECORDING_ENABLED=true

# ─── Lido Connect - Agent Routing ──────────────────────────────────────────
AGENT_ROUTING_STRATEGY=load-balanced
AGENT_QUEUE_TIMEOUT=300
AGENT_MAX_QUEUE_SIZE=100

# ─── Lido Connect - Limits ─────────────────────────────────────────────────
MAX_MESSAGE_LENGTH=10000
MAX_ATTACHMENT_SIZE=52428800
MAX_CALL_DURATION=3600
MAX_SUGGESTIONS=3

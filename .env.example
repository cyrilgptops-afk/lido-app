# Lido Development Environment Variables
# Copy this file to .env and fill in your values

# ==================== API Configuration ====================
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ==================== Authentication ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==================== Cache Configuration ====================
CACHE_ADAPTER=memory
CACHE_TTL=300
CACHE_PREFIX=lido

# ==================== Redis (if using redis adapter) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_MEMORY_MAX_SIZE=500

# ==================== MySQL Database ====================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lido_dev
MYSQL_POOL_SIZE=10

# ==================== OAuth Providers (TODO: Add your credentials) ====================
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=

# ==================== Queue/Jobs (TODO: Add when implementing) ====================
# REDIS_QUEUE_HOST=localhost
# REDIS_QUEUE_PORT=6379
# REDIS_QUEUE_PASSWORD=

# ==================== Monitoring (TODO: Add when implementing) ====================

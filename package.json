{
  "name": "lido-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Lido SaaS Automation Platform - Monorepo",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"blue,magenta,green\" \"npm run dev:api\" \"npm run dev:web\"",
    "minio": "D:\\Tools\\minio\\minio.exe server D:\\Tools\\minio\\data --console-address \":9001\"",
    "dev:api": "cd apps/api && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "start": "concurrently -n \"api,web\" -c \"blue,magenta\" \"npm run start:api\" \"npm run start:web\"",
    "start:api": "cd apps/api && npm start",
    "start:web": "cd apps/web && npm start",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "cd apps/api && npm run lint",
    "lint:web": "cd apps/web && npm run lint",
    "test": "npm run test:api",
    "test:api": "cd apps/api && npm test",
    "install:all": "npm install && cd apps/api && npm install && cd ../web && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
